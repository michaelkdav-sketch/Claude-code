# Ring credentials
RING_USERNAME=your@email.com
RING_PASSWORD=yourpassword

# Polling interval in seconds (default: 15)
POLL_INTERVAL=15

# Face recognition confidence threshold 0.0–1.0 (default: 0.5)
RECOGNITION_THRESHOLD=0.5

# Notification URLs (Apprise format, comma-separated)
# Examples:
#   Telegram: tgram://bottoken/chatid
#   Email:    mailto://user:pass@gmail.com
#   Twilio WhatsApp: twilio://accountsid:authtoken@fromnum/tonum?from=whatsapp
NOTIFICATION_URLS=

# Suppress duplicate notifications within N seconds (default: 300)
NOTIFICATION_COOLDOWN=300

# App host/port
APP_HOST=0.0.0.0
APP_PORT=8000
