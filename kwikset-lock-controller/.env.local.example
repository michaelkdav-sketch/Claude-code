# Seam API Configuration
# Get your API key at https://console.seam.co
SEAM_API_KEY=your_seam_api_key_here

# Optional: target a specific lock device ID
# If unset, the app uses the first lock found in your workspace
SEAM_DEVICE_ID=

# Basic Auth – protect the app with a username/password
AUTH_USERNAME=admin
AUTH_PASSWORD=change_this_password
