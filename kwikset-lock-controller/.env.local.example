# ── Seam API (Kwikset lock) ───────────────────────────────────────────────────
# Get your API key at https://console.seam.co
SEAM_API_KEY=your_seam_api_key_here

# Optional: target a specific lock device ID
# If unset, the app uses the first lock found in your workspace
SEAM_DEVICE_ID=

# ── Home Assistant (Roborock vacuum) ─────────────────────────────────────────
# Your local Home Assistant URL, e.g. http://homeassistant.local:8123
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Long-lived access token from your HA profile
# Profile → Security → Long-Lived Access Tokens → Create token
HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here

# Entity ID of your Roborock in Home Assistant, e.g. vacuum.roborock_curv_2
ROBOROCK_ENTITY_ID=vacuum.roborock_curv_2

# ── Basic Auth ────────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=change_this_password
